# Server Configuration (PRD Section 11.1)
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planora_db?schema=public"

# Authentication & Security (PRD Section 3 & 11.1)
JWT_SECRET="replace_with_a_secure_random_at_least_32_characters_secret"
JWT_EXPIRES_IN="7d"

# Client & Server URL (PRD Section 11.1)
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:5000"

# SSLCommerz Gateway Configuration (PRD Section 11.1)
SSLCZ_STORE_ID="planora_sandbox_store"
SSLCZ_STORE_PASSWORD="planora_sandbox_password"
SSLCZ_IS_LIVE="false"

# Seed Admin Credentials (PRD Section 11.1)
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@planora.com"
ADMIN_PASSWORD="AdminPassword123"
